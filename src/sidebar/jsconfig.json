{
  "extends": "../../jsconfig.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    // A jsconfig.json defaults this to 2 over what it extends, which would check the JavaScript
    // packages @types/node imports (punycode, string_decoder).
    "maxNodeModuleJsDepth": 0
  },
  // The scripts index.html loads, in its order: they share one global scope.
  "include": [
    "globals.d.ts",
    "../i18n/translate.js",
    "../i18n/page.js",
    "time.js",
    "checks.js",
    "press.js",
    "hover.js",
    "model.js",
    "data.js",
    "icons.js",
    "pulls.js",
    "rows.js",
    "uncloned.js",
    "github-bar.js",
    "update-card.js",
    "app-update-card.js",
    "usage-footer.js",
    "resize.js",
    "page-theme.js",
    "sidebar.js"
  ],
  "exclude": []
}
